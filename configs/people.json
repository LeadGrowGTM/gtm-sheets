{
  "version": "2",
  "settings": {
    "concurrency": 2,
    "rateLimit": 6,
    "retryAttempts": 2,
    "retryBackoff": "exponential"
  },
  "tabs": {
    "people": {
      "name": "people",
      "columns": {
        "A": "company_name",
        "B": "website",
        "C": "city",
        "D": "state",
        "E": "first_name",
        "F": "last_name",
        "G": "title",
        "H": "linkedin_url",
        "I": "email",
        "J": "email_source"
      },
      "actions": [
        {
          "id": "owner_discovery",
          "name": "Owner Discovery",
          "type": "ai",
          "runtime": "claude",
          "model": "claude-sonnet-4-6",
          "tools": true,
          "target": "first_name",
          "when": "{{row.first_name}} == '' && {{row.company_name}} != ''",
          "prompt": "Find the owner, founder, or principal decision-maker for {{row.company_name}} at {{row.website}} located in {{row.city}} {{row.state}}. Search LinkedIn and the web. Return JSON only with no extra text: {\"first_name\": \"\", \"last_name\": \"\", \"title\": \"\"}. If not found, return {\"first_name\": \"❌\", \"last_name\": \"\", \"title\": \"\"}.",
          "outputs": {
            "first_name": { "type": "text" },
            "last_name": { "type": "text" },
            "title": { "type": "text" }
          },
          "timeout": 90
        },
        {
          "id": "email_waterfall",
          "name": "Email Waterfall",
          "type": "waterfall",
          "target": "email",
          "when": "{{row.email}} == '' && {{row.linkedin_url}} != ''",
          "providers": [
            {
              "name": "icypeas",
              "method": "POST",
              "url": "https://app.icypeas.com/api/email-search",
              "headers": {
                "Authorization": "Bearer {{env.ICYPEAS_API_KEY}}",
                "Content-Type": "application/json"
              },
              "body": {
                "linkedin": "{{row.linkedin_url}}",
                "firstname": "{{row.first_name}}",
                "lastname": "{{row.last_name}}",
                "domainOrCompany": "{{row.website}}"
              },
              "extract": "$.item.email",
              "onError": { "default": "skip" }
            },
            {
              "name": "leadmagic",
              "method": "POST",
              "url": "https://api.leadmagic.io/email-finder",
              "headers": {
                "X-LEADMAGIC-API-KEY": "{{env.LEADMAGIC_API_KEY}}",
                "Content-Type": "application/json"
              },
              "body": {
                "profile_url": "{{row.linkedin_url}}"
              },
              "extract": "$.email",
              "onError": { "default": "skip" }
            },
            {
              "name": "millionverifier",
              "method": "GET",
              "url": "https://api.millionverifier.com/api/v3/?api={{env.MILLIONVERIFIER_API_KEY}}&email={{row.first_name}}.{{row.last_name}}@{{row.website}}",
              "extract": "$.quality == 'good' ? '{{row.first_name}}.{{row.last_name}}@{{row.website}}' : ''",
              "onError": { "default": "skip" }
            }
          ]
        }
      ]
    }
  }
}
