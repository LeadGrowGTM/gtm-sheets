{
  "version": "2",
  "settings": {
    "concurrency": 2,
    "rateLimit": 6,
    "retryAttempts": 2,
    "retryBackoff": "exponential"
  },
  "tabs": {
    "people": {
      "name": "people",
      "columns": {
        "A": "company_name",
        "B": "website",
        "C": "company_linkedin_url",
        "D": "first_name",
        "E": "last_name",
        "F": "title",
        "G": "linkedin_url",
        "H": "email",
        "I": "email_source",
        "J": "email_verified",
        "K": "ark_status"
      },
      "actions": [
        {
          "id": "ai_ark_find",
          "name": "AI Ark People Find",
          "type": "exec",
          "target": "ark_status",
          "when": "{{row.ark_status}} == '' && {{row.company_name}} != ''",
          "command": "ai-ark people --company '{{row.company_name}}' --domain '{{row.website}}' --titles 'owner,founder,CEO,president,managing director' --limit 3 --json",
          "extract": "$.contacts[0].linkedin_url",
          "timeout": 120,
          "onError": { "default": { "write": "❌" } }
        },
        {
          "id": "email_waterfall",
          "name": "Email Waterfall",
          "type": "waterfall",
          "target": "email",
          "when": "{{row.email}} == '' && {{row.linkedin_url}} != ''",
          "providers": [
            {
              "name": "icypeas",
              "method": "POST",
              "url": "https://app.icypeas.com/api/email-search",
              "headers": {
                "Authorization": "Bearer {{env.ICYPEAS_API_KEY}}",
                "Content-Type": "application/json"
              },
              "body": {
                "linkedin": "{{row.linkedin_url}}",
                "firstname": "{{row.first_name}}",
                "lastname": "{{row.last_name}}",
                "domainOrCompany": "{{row.website}}"
              },
              "extract": "$.item.email",
              "onError": { "default": "skip" }
            },
            {
              "name": "leadmagic",
              "method": "POST",
              "url": "https://api.leadmagic.io/email-finder",
              "headers": {
                "X-LEADMAGIC-API-KEY": "{{env.LEADMAGIC_API_KEY}}",
                "Content-Type": "application/json"
              },
              "body": {
                "profile_url": "{{row.linkedin_url}}"
              },
              "extract": "$.email",
              "onError": { "default": "skip" }
            },
            {
              "name": "millionverifier",
              "method": "GET",
              "url": "https://api.millionverifier.com/api/v3/?api={{env.MILLIONVERIFIER_API_KEY}}&email={{row.first_name}}.{{row.last_name}}@{{row.website}}",
              "extract": "$.quality == 'good' ? '{{row.first_name}}.{{row.last_name}}@{{row.website}}' : ''",
              "onError": { "default": "skip" }
            }
          ]
        },
        {
          "id": "write_to_people_tab",
          "name": "Write Contacts to People Tab",
          "type": "write",
          "target": "ark_status",
          "when": "{{row.ark_status}} == 'found'",
          "destTab": "people",
          "mode": "upsert",
          "upsertMatch": {
            "column": "linkedin_url",
            "value": "{{row.linkedin_url}}"
          },
          "columns": {
            "company_name": "{{row.company_name}}",
            "website": "{{row.website}}",
            "company_linkedin_url": "{{row.company_linkedin_url}}",
            "first_name": "{{row.first_name}}",
            "last_name": "{{row.last_name}}",
            "title": "{{row.title}}",
            "linkedin_url": "{{row.linkedin_url}}"
          }
        }
      ]
    }
  },
  "actions": []
}
