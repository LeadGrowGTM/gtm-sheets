{
  "version": "2",
  "settings": {
    "concurrency": 3,
    "rateLimit": 5,
    "retryAttempts": 2,
    "retryBackoff": "exponential"
  },
  "tabs": {
    "companies": {
      "name": "companies",
      "columns": {
        "A": "company_name",
        "B": "website",
        "C": "industry",
        "D": "city",
        "E": "state",
        "F": "homepage_email",
        "G": "tech_stack",
        "H": "recent_news"
      },
      "actions": [
        {
          "id": "find_website",
          "name": "Find Website",
          "type": "ai",
          "runtime": "claude",
          "model": "claude-sonnet-4-6",
          "tools": true,
          "target": "website",
          "when": "{{row.website}} == ''",
          "prompt": "Find the official website URL for {{row.company_name}} located in {{row.city}} {{row.state}}. Search the web and return only the URL (e.g. https://example.com), nothing else. If not found, return '❌'.",
          "timeout": 60
        },
        {
          "id": "tech_stack",
          "name": "Tech Stack",
          "type": "exec",
          "target": "tech_stack",
          "when": "{{row.tech_stack}} == '' && {{row.website}} != ''",
          "command": "techsight scan {{row.website}} --mode lite --json-output",
          "extract": "$.stacks",
          "timeout": 60,
          "onError": { "default": { "write": "❌" } }
        },
        {
          "id": "recent_news",
          "name": "Recent News",
          "type": "ai",
          "runtime": "claude",
          "model": "claude-sonnet-4-6",
          "tools": true,
          "target": "recent_news",
          "when": "{{row.recent_news}} == '' && {{row.company_name}} != ''",
          "prompt": "Search for news about {{row.company_name}} ({{row.website}}) from the last 90 days. Return a single sentence summary of the most relevant news, or 'No recent news' if nothing found.",
          "timeout": 60
        },
        {
          "id": "homepage_email",
          "name": "Homepage Email",
          "type": "ai",
          "runtime": "claude",
          "model": "claude-sonnet-4-6",
          "tools": true,
          "target": "homepage_email",
          "when": "{{row.homepage_email}} == '' && {{row.website}} != ''",
          "prompt": "Visit {{row.website}} and find a contact email address. Check the homepage, contact page, and footer. Return only the email address (e.g. hello@company.com), or '❌' if none found.",
          "timeout": 60
        }
      ]
    }
  }
}
